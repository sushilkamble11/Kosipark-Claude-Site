# Secrets — never commit
public_html/api/gp/config.php
public_html/api/ops/config.php
.env

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Design-canvas local state (public_html/.image-slots.state.json is
# deliberately shipped, empty, so image-slot.js does not 404 on it)
.thumbnail

# Test artefacts
test/shots/
node_modules/

# Proxy runtime cache. Holds live GuestPoint responses — guest names, emails
# and reservation ids — so it must never reach the repo. The proxy recreates
# it on demand and falls back to the system temp dir when it cannot.
gp-cache/

# Per-developer Claude Code settings (permission rules for the local proxy).
# The shared .claude/settings.json, if one is ever added, stays tracked.
.claude/settings.local.json

# Added through GitHub"'s web UI: a PAT cannot push workflow files
# without the workflow scope, and this one is deliberately minimal.
.github/
