# Route every /api/gp/... request into index.php, keeping the path in PATH_INFO.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/gp/

  # The !index.php guard is load-bearing. Without it the rewritten URL matches
  # the rule again on the next pass — index.php/index.php/index.php... — and the
  # server answers 500 rather than looping forever. [L] does not prevent this:
  # it ends one pass, not the re-run against the new URL.
  RewriteCond %{REQUEST_URI} !(^|/)index\.php(/|$)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# The key lives in config.php. It must never be served, whatever the routing does.
<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
