# Kosciuszko Tourist Park — routing, security and caching
# Target: Hostinger shared hosting (LiteSpeed, Apache-compatible)

Options -Indexes
ServerSignature Off

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical host + HTTPS -------------------------------------------
  # Uncomment once DNS points here. Set the host you want to be canonical.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Home (before the -d check, since "/" is a directory) --------------
  RewriteRule ^$ Kosipark.dc.html [L]

  # --- Never touch the API proxy ----------------------------------------
  RewriteRule ^api/ - [L]

  # --- Real files and directories win -----------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --- Routes -----------------------------------------------------------
  RewriteRule ^accommodation/?$                Accommodation.dc.html   [L]
  RewriteRule ^accommodation/([a-z0-9-]+)/?$   Room.dc.html?room=$1    [L,QSA]
  RewriteRule ^book/?$                         Availability.dc.html    [L,QSA]
  RewriteRule ^book/calendar/?$                Calendar.dc.html        [L,QSA]
  RewriteRule ^book/checkout/?$                Checkout.dc.html        [L,QSA]
  RewriteRule ^manage/?$                       Manage.dc.html          [L,QSA]
  RewriteRule ^terms/?$                        Terms.dc.html           [L]
  RewriteRule ^privacy/?$                      Privacy.dc.html         [L]
  RewriteRule ^attractions/?$                  Attractions.dc.html     [L]
  RewriteRule ^gallery/?$                      Gallery.dc.html         [L]
  RewriteRule ^contact/?$                      Contact.dc.html         [L]

  # Old design-canvas filenames -> clean URLs (301, keeps any stray links alive)
  RewriteRule ^Kosipark\.dc\.html$      /            [L,R=301]
  RewriteRule ^Accommodation\.dc\.html$ /accommodation [L,R=301]
  RewriteRule ^Attractions\.dc\.html$   /attractions [L,R=301]
  RewriteRule ^Gallery\.dc\.html$       /gallery     [L,R=301]
  RewriteRule ^Contact\.dc\.html$       /contact     [L,R=301]
  RewriteRule ^Manage\.dc\.html$        /manage      [L,R=301]
  RewriteRule ^Terms\.dc\.html$         /terms       [L,R=301]
  RewriteRule ^Privacy\.dc\.html$       /privacy     [L,R=301]
</IfModule>

# --- Never serve secrets or VCS metadata --------------------------------
<FilesMatch "^(config\.php|\.env|\.git.*|composer\.(json|lock)|.*\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# --- Compression --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Caching ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  # HTML and JS are the app itself — revalidate so a deploy is picked up at once
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/javascript    "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
